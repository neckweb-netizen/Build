{
  "name": "mapcine",
  "version": "0.1.0",
  "private": true,
  "description": "MapCine — estúdio de mapas animados (web + Android)",
  "type": "module",
  "scripts": {
    "dev": "http-server www -p 4173 -c-1",
    "sync": "cap sync android && node scripts/prepare-android.mjs",
    "android": "cap open android",
    "build:apk": "npm run sync && cd android && gradlew.bat assembleDebug",
    "data:cities": "node scripts/build-cities.mjs",
    "data:municipios": "node scripts/build-municipios.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0"
  }
}
